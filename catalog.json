    "commands": {
      "path": "commands",
      "format": ".md (YAML frontmatter: description) + prompt body",
      "items": [
        {
          "name": "commit",
          "file": "commands/commit.md",
          "description": "Conventional Commit из staged-изменений."
        },
        {
          "name": "review-diff",
          "file": "commands/review-diff.md",
          "description": "Ревью текущего diff."
        },
        {
          "name": "write-tests",
          "file": "commands/write-tests.md",
          "description": "Тесты для указанного файла/функции."
        }
      ]
    },
    "hooks": {
      "path": "hooks",
      "format": "executable script wired via settings.json",
      "items": []
    },
    "mcp": {
      "path": "mcp",
      "format": "JSON config with mcpServers entry",
      "items": []
    },
    "prompts": {
      "path": "prompts",
      "format": "free-form markdown",
      "items": [
        {
          "name": "rubber-duck-debugging",
          "file": "prompts/rubber-duck-debugging.md",
          "description": "Пошаговый разбор бага методом утёнка."
