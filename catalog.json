    "docs": {
      "path": "docs",
      "format": "markdown notes",
      "items": [
        {
          "name": "best-practices",
          "file": "docs/best-practices.md",
          "description": "Рекомендации по наполнению коллекции."
        },
        {
          "name": "writing-good-skills",
          "file": "docs/writing-good-skills.md",
          "description": "Как писать качественные скиллы Claude Code."
