{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "best",
  "description": "Личная коллекция инструментов для Claude Code.",
  "version": "0.2.0",
  "updated": "2026-05-28",
  "categories": {
    "skills": {
      "path": "skills",
      "format": "directory with SKILL.md (YAML frontmatter: name, description)",
      "items": [
        {
          "name": "pdf-extract",
          "file": "skills/pdf-extract/SKILL.md",
          "description": "Извлечение текста, таблиц и метаданных из PDF."
        },
        {
          "name": "changelog-from-commits",
          "file": "skills/changelog-from-commits/SKILL.md",
          "description": "Сборка changelog/release notes из истории git."
        },
        {
          "name": "dependency-audit",
          "file": "skills/dependency-audit/SKILL.md",
          "description": "Аудит зависимостей на уязвимости и устаревание."
        }
      ]
    },
    "agents": {
      "path": "agents",
      "format": ".md (YAML frontmatter: name, description) + system prompt",
      "items": [
        {
          "name": "code-reviewer",
